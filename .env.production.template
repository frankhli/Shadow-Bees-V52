# =============================================================================
# Shadow-Bees V2 生产环境配置模板
# 部署前请将所有 <...> 替换为实际值
# 此文件包含敏感信息，请勿提交到 Git！
# =============================================================================

# =============================================================================
# 基础配置
# =============================================================================
NODE_ENV=production
PORT=3000

# =============================================================================
# 前端域名配置（用于 CORS）
# =============================================================================
# 主前端地址（酒店端）
FRONTEND_URL=https://your-domain.com
# 管理端地址
ADMIN_URL=https://admin.your-domain.com
# 集团端地址
GROUP_URL=https://group.your-domain.com

# =============================================================================
# 数据库配置（阿里云 RDS）
# =============================================================================
# PostgreSQL 连接字符串（含连接池配置）
# 格式: postgresql://用户名:密码@主机:端口/数据库名?参数
# 连接池参数: connection_limit=20(最大连接数)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/shadowbees?connection_limit=20&pool_timeout=30

# 数据库连接池配置（Prisma 通过 URL 参数控制）
# connection_limit=20: 最大 20 个连接（支撑几百家酒店）
# pool_timeout=30: 获取连接超时 30 秒

# =============================================================================
# Redis 缓存配置（阿里云 Redis）
# =============================================================================
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_ENDPOINT>:6379

# =============================================================================
# JWT 认证配置
# =============================================================================
# JWT 密钥（至少 32 位随机字符串，可使用: openssl rand -base64 32）
JWT_SECRET=<GENERATE_A_SECURE_RANDOM_STRING_32_CHARS_MIN>
JWT_EXPIRES_IN=7d

# =============================================================================
# AI 服务配置
# =============================================================================
# 大模型 API 密钥（阿里通义千问 / 百度文心 / OpenAI）
AI_PROVIDER=alibaba
AI_API_KEY=<YOUR_AI_API_KEY>
AI_MODEL=qwen-max

# =============================================================================
# 文件存储配置（阿里云 OSS）
# =============================================================================
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=<YOUR_BUCKET_NAME>
OSS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>
OSS_ACCESS_KEY_SECRET=<YOUR_ACCESS_KEY_SECRET>
OSS_DOMAIN=https://<YOUR_BUCKET>.oss-cn-hangzhou.aliyuncs.com

# =============================================================================
# 监控与日志
# =============================================================================
# Sentry DSN（错误追踪）
SENTRY_DSN=<YOUR_SENTRY_DSN>

# 日志级别
LOG_LEVEL=info

# =============================================================================
# 微服务间通信（内部使用）
# =============================================================================
GATEWAY_URL=http://localhost:3000/api
HOTEL_SERVICE_URL=http://localhost:3001/api
ORDER_SERVICE_URL=http://localhost:3002/api
INVENTORY_SERVICE_URL=http://localhost:3003/api
PRICING_SERVICE_URL=http://localhost:3004/api
CONTENT_SERVICE_URL=http://localhost:3005/api

# =============================================================================
# 安全配置
# =============================================================================
# API 限流配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# 部署检查清单
# =============================================================================
# [ ] 1. 已替换所有 <...> 占位符
# [ ] 2. JWT_SECRET 已生成安全随机值
# [ ] 3. 数据库密码强度高（至少 16 位）
# [ ] 4. 所有外部服务（RDS/Redis/OSS）已创建并测试连接
# [ ] 5. 域名已备案（国内服务器必须）
# [ ] 6. SSL 证书已配置
# [ ] 7. 此文件已重命名为 .env.production（去掉 .template）
# [ ] 8. 此文件已添加到 .gitignore
# =============================================================================
