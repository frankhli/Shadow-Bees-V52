# Shadow-Bees V2 环境变量配置

# ==========================================
# 数据库配置
# ==========================================
DB_PASSWORD=shadowbees123
DATABASE_URL=postgresql://sb_admin:shadowbees123@localhost:5432/shadowbees

# ==========================================
# Redis 配置
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# JWT 密钥
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ==========================================
# AI 服务配置
# ==========================================
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
# 或使用国内模型
# QWEN_API_KEY=sk-xxx
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ==========================================
# 服务端口
# ==========================================
GATEWAY_PORT=3000
HOTEL_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
PRICING_SERVICE_PORT=3004
CONTENT_SERVICE_PORT=3005
AI_SERVICE_PORT=5000

# ==========================================
# 环境
# ==========================================
NODE_ENV=development
LOG_LEVEL=debug
