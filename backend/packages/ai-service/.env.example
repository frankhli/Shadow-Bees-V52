# AI Service 环境变量

# OpenAI / Azure OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 或 阿里云通义千问
# DASHSCOPE_API_KEY=sk-your-dashscope-key

# 服务配置
PORT=5000
LOG_LEVEL=info

# 功能开关
ENABLE_PRICING_AI=true
ENABLE_CONTENT_GENERATION=true
ENABLE_CONTENT_REVIEW=true
