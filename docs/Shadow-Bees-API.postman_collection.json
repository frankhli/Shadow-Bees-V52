{
  "info": {
    "name": "Shadow-Bees API",
    "description": "智能收益管理系统 API 测试集合",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "酒店管理",
      "item": [
        {
          "name": "获取酒店列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"]
            }
          },
          "response": []
        },
        {
          "name": "获取酒店详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels/{{hotelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "{{hotelId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "订单管理",
      "item": [
        {
          "name": "获取订单列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?hotelId={{hotelId}}&page=1&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "hotelId",
                  "value": "{{hotelId}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "创建订单",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"platform\": \"xianyu\",\n  \"customerName\": \"测试客户\",\n  \"customerPhone\": \"13800138000\",\n  \"checkInDate\": \"2024-06-01\",\n  \"checkOutDate\": \"2024-06-02\",\n  \"price\": 350\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Response has order id', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.collectionVariables.set('orderId', jsonData.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "更新订单状态",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"checked_in\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "定价管理",
      "item": [
        {
          "name": "获取定价建议",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pricing/suggest?hotelId={{hotelId}}&roomTypeId={{roomTypeId}}&date=2024-06-01",
              "host": ["{{baseUrl}}"],
              "path": ["pricing", "suggest"],
              "query": [
                {
                  "key": "hotelId",
                  "value": "{{hotelId}}"
                },
                {
                  "key": "roomTypeId",
                  "value": "{{roomTypeId}}"
                },
                {
                  "key": "date",
                  "value": "2024-06-01"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "更新价格",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"date\": \"2024-06-01\",\n  \"price\": 380,\n  \"reason\": \"周末溢价\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pricing/update",
              "host": ["{{baseUrl}}"],
              "path": ["pricing", "update"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "内容管理",
      "item": [
        {
          "name": "获取内容列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents?hotelId={{hotelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["contents"],
              "query": [
                {
                  "key": "hotelId",
                  "value": "{{hotelId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "AI生成内容",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"platform\": \"xiaohongshu\",\n  \"price\": 350,\n  \"sellingPoints\": [\"近地铁\", \"落地窗\", \"网红打卡\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contents/generate",
              "host": ["{{baseUrl}}"],
              "path": ["contents", "generate"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "仪表盘",
      "item": [
        {
          "name": "获取统计数据",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats?hotelId={{hotelId}}&range=today",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "stats"],
              "query": [
                {
                  "key": "hotelId",
                  "value": "{{hotelId}}"
                },
                {
                  "key": "range",
                  "value": "today"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 设置默认超时",
          "pm.request.timeout = {",
          "    connect: 5000,",
          "    read: 30000,",
          "    write: 10000",
          "};"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 通用响应检查",
          "pm.test('Response time is less than 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "pm.test('Response has valid JSON', function () {",
          "    pm.response.to.be.json;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "hotelId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "roomTypeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
